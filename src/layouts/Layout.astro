---
import "../styles/global.css";
import { LogoutButton } from "@/components/auth/LogoutButton";

interface Props {
  title?: string;
}

const { title = "10x Astro Starter" } = Astro.props;

// Check if user is logged in via Astro.locals.auth (set by middleware)
const isLoggedIn = !!Astro.locals.auth;
const userEmail = Astro.locals.auth?.user?.email;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    {
      isLoggedIn && (
        <div class="fixed right-4 top-4 z-50 flex items-center gap-3">
          {userEmail && <span class="text-sm text-muted-foreground">{userEmail}</span>}
          <LogoutButton client:load />
        </div>
      )
    }
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
