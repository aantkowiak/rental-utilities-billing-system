---
import { ProfileForm } from "@/components/profile/ProfileForm";
import RoleNav from "@/components/nav/RoleNav.astro";
import { requireAuth } from "@/lib/api/auth";
import Layout from "../../layouts/Layout.astro";

const auth = await requireAuth(Astro.request, Astro.locals);
if (!auth.success) {
  return auth.response;
}

// Redirect admin to /admin/profile
if (auth.role === "admin") {
  return Astro.redirect("/admin/profile");
}

const pageTitle = "Profil użytkownika";
---

<Layout title="Profil">
  <a
    class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:rounded-md focus:bg-primary focus:px-3 focus:py-2 focus:text-primary-foreground"
    href="#main-content"
  >
    Przejdź do treści
  </a>

  <header class="border-b bg-card">
    <div class="mx-auto flex max-w-4xl flex-col gap-4 px-4 py-6">
      <div>
        <p class="text-sm text-muted-foreground">Panel najemcy</p>
        <h1 class="text-2xl font-semibold text-foreground">{pageTitle}</h1>
      </div>
      <RoleNav currentPath="/app/profile" role="tenant" />
    </div>
  </header>

  <main id="main-content" class="mx-auto w-full max-w-4xl px-4 py-8">
    <ProfileForm client:load />
  </main>
</Layout>
