---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Login">
  <main style="display:grid;gap:1rem;padding:1rem;max-width:420px;margin:0 auto;">
    <h1>Sign in</h1>
    <form id="login-form" style="display:grid;gap:0.5rem" aria-label="Login form">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" required placeholder="you@example.com" />
      <button type="submit">Send magic link</button>
      <div id="login-status" role="status" aria-live="polite"></div>
    </form>
  </main>
  <script>
    const form = document.getElementById('login-form');
    const statusEl = document.getElementById('login-status');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const email = fd.get('email');
      statusEl.textContent = '';
      try {
        const res = await fetch('/api/v1/auth/magic-link', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        if (!res.ok) {
          // still show success per API contract preventing enumeration
          statusEl.textContent = 'If the email exists, a magic link was sent.';
          return;
        }
        statusEl.textContent = 'Check your email for a magic link.';
      } catch (err) {
        statusEl.textContent = 'If the email exists, a magic link was sent.';
      }
    });
  </script>
</Layout>


