---
import Layout from "../../layouts/Layout.astro";
import { ForgotPasswordView } from "@/components/auth/ForgotPasswordForm";

const pageTitle = "Resetowanie hasła";
---

<Layout title={pageTitle}>
  <a
    class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:rounded-md focus:bg-primary focus:px-3 focus:py-2 focus:text-primary-foreground"
    href="#main-content"
  >
    Przejdź do treści
  </a>

  <main id="main-content" class="mx-auto w-full max-w-sm px-4 py-8" role="main">
    <div class="w-full space-y-8">
      <header class="space-y-4 text-center">
        <div
          class="mx-auto flex size-12 items-center justify-center rounded-full border border-border bg-card shadow-sm"
        >
          <img alt="Rental Utilities Billing System" class="size-8" height="32" src="/favicon.png" width="32" />
        </div>
        <div class="space-y-2">
          <p class="text-sm text-muted-foreground">Odzyskiwanie hasła</p>
          <h1 class="text-3xl font-semibold tracking-tight">Zresetuj hasło</h1>
          <p class="text-sm text-muted-foreground">
            Podaj adres e-mail, a wyślemy Ci link do zresetowania hasła.
          </p>
        </div>
      </header>

      <ForgotPasswordView client:load />
    </div>
  </main>
</Layout>

